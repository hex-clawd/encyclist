# Encyclist Web UI — local config template.
# Copy to `.env` and fill in real values. `.env` is gitignored.

# Remote Encyclist MCP endpoint (StreamableHTTP).
ENCYCLIST_URL=https://encyclist.fly.dev/mcp

# API key for the remote server. Use the "hermes" key for the local UI
# since it runs on the same machine as the rest of the local stack.
ENCYCLIST_API_KEY=ec-replace-me

# Optional: bind host/port for the local web server (defaults shown).
WEB_HOST=127.0.0.1
WEB_PORT=8080
